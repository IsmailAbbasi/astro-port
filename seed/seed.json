{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "astro-port",
		"description": "Dark, minimal developer portfolio with a blog, projects and tech stack",
		"author": "Ismail"
	},
	"settings": {
		"title": "Ismail",
		"tagline": "Developer portfolio & blog"
	},
	"collections": [
		{
			"slug": "profile",
			"label": "Profile",
			"labelSingular": "Profile",
			"description": "Hero section, contact details, CV and social links. Keep exactly one published entry.",
			"routable": false,
			"sortOrder": 1,
			"supports": ["drafts", "revisions"],
			"fields": [
				{ "slug": "title", "label": "Name", "type": "string", "required": true },
				{ "slug": "role", "label": "Role", "type": "string" },
				{ "slug": "email", "label": "Email", "type": "string" },
				{ "slug": "bio", "label": "Bio (bold text is highlighted)", "type": "portableText" },
				{ "slug": "available", "label": "Available for work", "type": "boolean", "defaultValue": true },
				{
					"slug": "cv",
					"label": "CV (PDF)",
					"type": "file",
					"validation": { "allowedMimeTypes": ["application/pdf"] }
				},
				{ "slug": "hire_url", "label": "Hire Me link (defaults to email)", "type": "url" },
				{ "slug": "x_url", "label": "X profile URL", "type": "url" },
				{ "slug": "bento_url", "label": "Bento profile URL", "type": "url" },
				{ "slug": "github_url", "label": "GitHub profile URL", "type": "url" },
				{ "slug": "linkedin_url", "label": "LinkedIn profile URL", "type": "url" }
			]
		},
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"sortOrder": 2,
			"supports": ["drafts", "revisions", "preview", "scheduling", "search", "seo"],
			"urlPattern": "/posts/{slug}",
			"fields": [
				{ "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
				{ "slug": "excerpt", "label": "Excerpt", "type": "text", "searchable": true },
				{ "slug": "featured_image", "label": "Cover image", "type": "image" },
				{ "slug": "content", "label": "Content", "type": "portableText", "searchable": true }
			]
		},
		{
			"slug": "projects",
			"label": "Projects",
			"labelSingular": "Project",
			"sortOrder": 3,
			"supports": ["drafts", "revisions", "preview", "search", "seo"],
			"urlPattern": "/projects/{slug}",
			"fields": [
				{ "slug": "title", "label": "Title", "type": "string", "required": true, "searchable": true },
				{ "slug": "summary", "label": "Short description", "type": "text", "searchable": true },
				{ "slug": "year", "label": "Year", "type": "string" },
				{ "slug": "live_url", "label": "Live URL", "type": "url" },
				{ "slug": "github_url", "label": "GitHub URL", "type": "url" },
				{ "slug": "featured", "label": "Show on home page", "type": "boolean", "defaultValue": true },
				{ "slug": "featured_image", "label": "Cover image", "type": "image" },
				{ "slug": "content", "label": "Case study", "type": "portableText", "searchable": true }
			]
		},
		{
			"slug": "stack",
			"label": "Tech Stack",
			"labelSingular": "Technology",
			"description": "Badges shown in the Tech Stack section, grouped by category.",
			"routable": false,
			"sortOrder": 4,
			"supports": [],
			"fields": [
				{ "slug": "title", "label": "Name", "type": "string", "required": true },
				{
					"slug": "category",
					"label": "Category",
					"type": "select",
					"required": true,
					"indexed": true,
					"defaultValue": "Frontend",
					"validation": { "options": ["Frontend", "Backend", "Database", "DevOps", "Tools"] }
				},
				{ "slug": "simple_icon", "label": "Simple Icons slug (e.g. react, nodedotjs)", "type": "string" },
				{ "slug": "icon", "label": "Custom icon (overrides Simple Icons)", "type": "image" }
			]
		}
	],
	"taxonomies": [
		{
			"name": "tag",
			"label": "Tags",
			"labelSingular": "Tag",
			"hierarchical": false,
			"collections": ["posts"],
			"terms": [
				{ "slug": "astro", "label": "Astro" },
				{ "slug": "emdash", "label": "EmDash" },
				{ "slug": "cloudflare", "label": "Cloudflare" },
				{ "slug": "web-dev", "label": "Web Dev" },
				{ "slug": "notes", "label": "Notes" }
			]
		},
		{
			"name": "tech",
			"label": "Technologies",
			"labelSingular": "Technology",
			"hierarchical": false,
			"collections": ["projects"],
			"terms": [
				{ "slug": "react", "label": "React" },
				{ "slug": "nextjs", "label": "Next.js" },
				{ "slug": "astro", "label": "Astro" },
				{ "slug": "typescript", "label": "TypeScript" },
				{ "slug": "nodejs", "label": "Node.js" },
				{ "slug": "python", "label": "Python" },
				{ "slug": "postgresql", "label": "PostgreSQL" },
				{ "slug": "mongodb", "label": "MongoDB" },
				{ "slug": "tailwind", "label": "Tailwind" },
				{ "slug": "docker", "label": "Docker" },
				{ "slug": "cloudflare", "label": "Cloudflare" },
				{ "slug": "emdash", "label": "EmDash" }
			]
		}
	],
	"menus": [
		{
			"name": "primary",
			"label": "Primary Navigation",
			"items": [
				{ "type": "custom", "label": "Home", "url": "/" },
				{ "type": "custom", "label": "Posts", "url": "/posts" }
			]
		}
	],
