				"id": "post-how-this-site-works",
				"slug": "how-this-site-works",
				"status": "published",
				"data": {
					"title": "How this portfolio is built",
					"excerpt": "Astro renders every page on the server, EmDash stores the content in Cloudflare D1, and the whole thing runs as a single Cloudflare Worker.",
					"content": [
						{
							"_type": "block",
							"_key": "w1",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "w1s1",
									"text": "This site is an Astro project with the EmDash CMS integration, deployed to Cloudflare Workers."
								}
							]
						},
						{
							"_type": "block",
							"_key": "w2",
							"style": "h2",
							"children": [{ "_type": "span", "_key": "w2s1", "text": "The pieces" }]
						},
						{
							"_type": "block",
							"_key": "w3",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"children": [
								{ "_type": "span", "_key": "w3s1", "text": "Astro", "marks": ["strong"] },
								{ "_type": "span", "_key": "w3s2", "text": " renders each page on request, so published changes appear without a rebuild." }
							]
						},
						{
							"_type": "block",
							"_key": "w4",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"children": [
								{ "_type": "span", "_key": "w4s1", "text": "EmDash", "marks": ["strong"] },
								{ "_type": "span", "_key": "w4s2", "text": " provides the admin panel, media library, menus and taxonomies." }
							]
						},
						{
							"_type": "block",
							"_key": "w5",
							"style": "normal",
							"listItem": "bullet",
							"level": 1,
							"children": [
								{ "_type": "span", "_key": "w5s1", "text": "Cloudflare D1 and R2", "marks": ["strong"] },
								{ "_type": "span", "_key": "w5s2", "text": " store the content database and uploaded files." }
							]
						},
						{
							"_type": "block",
							"_key": "w6",
							"style": "h2",
							"children": [{ "_type": "span", "_key": "w6s1", "text": "Why server-rendered" }]
