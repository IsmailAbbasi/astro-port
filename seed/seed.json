						},
						{
							"_type": "block",
							"_key": "w8",
							"style": "blockquote",
							"children": [
								{
									"_type": "span",
									"_key": "w8s1",
									"text": "Code changes go through git. Content changes go through the admin panel."
								}
							]
						}
					]
				},
				"taxonomies": { "tag": ["astro", "emdash", "cloudflare"] }
			},
			{
