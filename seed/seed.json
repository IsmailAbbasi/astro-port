								{ "_type": "span", "_key": "b1s3", "text": " who builds fast, content-first web apps with " },
								{ "_type": "span", "_key": "b1s4", "text": "React", "marks": ["strong"] },
								{ "_type": "span", "_key": "b1s5", "text": ", " },
								{ "_type": "span", "_key": "b1s6", "text": "Astro", "marks": ["strong"] },
								{ "_type": "span", "_key": "b1s7", "text": " and " },
								{ "_type": "span", "_key": "b1s8", "text": "TypeScript", "marks": ["strong"] },
								{ "_type": "span", "_key": "b1s9", "text": ", backed by " },
								{ "_type": "span", "_key": "b1s10", "text": "Node.js", "marks": ["strong"] },
								{ "_type": "span", "_key": "b1s11", "text": " and edge platforms like " },
								{ "_type": "span", "_key": "b1s12", "text": "Cloudflare", "marks": ["strong"] },
								{ "_type": "span", "_key": "b1s13", "text": ". Edit this bio in the admin panel under Profile." }
							]
						}
					]
				}
			}
		],
		"posts": [
			{
				"id": "post-hello-world",
				"slug": "hello-world",
				"status": "published",
				"data": {
					"title": "Hello, world",
					"excerpt": "The first post on the new site. Replace it with your own introduction from the admin panel.",
					"content": [
						{
							"_type": "block",
							"_key": "h1",
							"style": "normal",
							"children": [
