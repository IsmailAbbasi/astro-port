---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import BlogCard from "../components/BlogCard.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import ProjectPayload from "../components/ProjectPayload.astro";
import SectionHead from "../components/SectionHead.astro";
import StackTable from "../components/StackTable.astro";
import StatStrip from "../components/StatStrip.astro";
import WorkLog from "../components/WorkLog.astro";
import { getProjectExtras, site } from "../data/site";
import { flag, getProfile, getSocialLinks } from "../lib/profile";
import { getReadingTime } from "../lib/format";

const [profileResult, postsResult, projectsResult, stackResult] = await Promise.all([
	getProfile(),
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 3 }),
	getEmDashCollection("projects", { orderBy: { published_at: "desc" }, limit: 24 }),
	getEmDashCollection("stack", { orderBy: { title: "asc" }, limit: 100 }),
]);
if (postsResult.error || projectsResult.error || stackResult.error) {
	return new Response("Could not load the portfolio", { status: 500 });
}
if (Astro.cache?.enabled) {
	Astro.cache.set(profileResult.cacheHint);
	Astro.cache.set(postsResult.cacheHint);
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(stackResult.cacheHint);
}

const { profile } = profileResult;
const posts = postsResult.entries;

// "Show on home page" defaults to on, so only an explicit "off" hides a project.
const projects = projectsResult.entries.filter((p) => flag(p.data.featured, true));
// One batched query each for the projects' technologies and the posts' tags.
const [techByProject, tagsByPost] = await Promise.all([
	getTermsForEntries(
		"projects",
		projects.map((p) => p.data.id),
		"tech",
	),
	getTermsForEntries(
		"posts",
		posts.map((p) => p.data.id),
		"tag",
	),
]);

// Group the tech stack by category, in a fixed category order.
const CATEGORY_ORDER = ["Frontend", "Backend", "Database", "DevOps", "Tools"];
const groups = new Map<string, string[]>();
for (const item of stackResult.entries) {
	const category = item.data.category || "Other";
	groups.set(category, [...(groups.get(category) ?? []), item.data.title]);
}
const stackGroups = [...groups.entries()].sort(
	([a], [b]) =>
		(CATEGORY_ORDER.indexOf(a) + 1 || CATEGORY_ORDER.length + 1) -
		(CATEGORY_ORDER.indexOf(b) + 1 || CATEGORY_ORDER.length + 1),
);
---

<Base description={profile?.data.role}>
	<Hero profile={profile} />

	<StatStrip />

	<WorkLog />

	<section class="wrap sec" id="projects" aria-labelledby="projects-title">
		<SectionHead id="projects-title" eyebrow={site.projects.eyebrow} title={site.projects.title} lede={site.projects.lede} />
		{
			projects.length > 0 ? (
				<div class="payloads">
					{projects.map((project, i) => (
						<ProjectPayload
							index={i}
							title={project.data.title}
							href={`/projects/${project.id}`}
							summary={project.data.summary}
							year={project.data.year}
							technologies={(techByProject.get(project.data.id) ?? []).map((t) => t.label)}
							liveUrl={project.data.live_url}
							githubUrl={project.data.github_url}
							image={project.data.featured_image}
							extras={getProjectExtras(project.id, project.data.title)}
							edit={project.edit}
						/>
					))}
				</div>
			) : (
				<p class="empty-state">
					No projects yet. <a href="/_emdash/admin/content/projects/new">Add a project</a>.
				</p>
			)
		}
		<p class="sec-foot">
			<a class="lnk" href="/projects">All projects →</a>
		</p>
	</section>

	<section class="wrap sec" id="writing" aria-labelledby="writing-title">
		<SectionHead id="writing-title" eyebrow={site.writing.eyebrow} title={site.writing.title} lede={site.writing.lede} />
		{
			posts.length > 0 ? (
				<div class="log">
					{posts.map((post, i) => (
						<BlogCard
							title={post.data.title}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt}
							excerpt={post.data.excerpt}
							readingTime={getReadingTime(post.data.content)}
							tags={(tagsByPost.get(post.data.id) ?? []).map((t) => t.label)}
							edit={post.edit}
							revealDelay={i * 80}
						/>
					))}
				</div>
			) : (
				<p class="empty-state">
					No posts yet. <a href="/_emdash/admin/content/posts/new">Write the first one</a>.
				</p>
			)
		}
		<p class="sec-foot">
			<a class="lnk" href="/posts">All posts →</a>
		</p>
	</section>

	<StackTable groups={stackGroups} />

	<Contact profile={profile} socials={getSocialLinks(profile?.data)} />
</Base>
