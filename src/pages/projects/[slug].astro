---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import CricStackDemo from "../../components/demos/CricStackDemo.astro";
import ExaminateDemo from "../../components/demos/ExaminateDemo.astro";
import InterceptDemo from "../../components/demos/InterceptDemo.astro";
import { getProjectExtras, site } from "../../data/site";
import { safeExternalUrl } from "../../lib/profile";
import type { Project } from "../../../emdash-env";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: project, error, cacheHint } = await getEmDashEntry("projects", slug);
if (error) return new Response("Could not load the project", { status: 500 });
if (!project) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function absoluteImageUrl(image: Project["featured_image"]): string | undefined {
	if (!image) return undefined;
	if (image.src) return image.src.startsWith("http") ? image.src : new URL(image.src, Astro.url.origin).href;
	const storageKey = typeof image.meta?.storageKey === "string" ? image.meta.storageKey : image.id;
	return storageKey ? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}` : undefined;
}

const seo = getSeoMeta(project, {
	siteUrl: Astro.url.origin,
	path: `/projects/${slug}`,
	defaultDescription: project.data.summary,
	defaultOgImage: absoluteImageUrl(project.data.featured_image),
});

const technologies = project.data.terms?.tech ?? [];
const liveUrl = safeExternalUrl(project.data.live_url);
const githubUrl = safeExternalUrl(project.data.github_url);
const extras = getProjectExtras(project.id, project.data.title);
const DEMOS = { intercept: InterceptDemo, examinate: ExaminateDemo, cricstack: CricStackDemo };
const Demo = extras?.demo ? DEMOS[extras.demo] : undefined;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	content={{ collection: "projects", id: project.data.id, slug }}
>
	<article class="wrap page project">
		<a href="/projects" class="back">← All projects</a>

		<header class="project-head">
			<p class="k project-meta">
				<span class="accent">{site.projects.eyebrow}</span>
				{extras?.category && <span>{extras.category}</span>}
				{project.data.year && <span {...project.edit.year}>{project.data.year}</span>}
			</p>
			<h1 class="project-title" {...project.edit.title}>{project.data.title}</h1>
			{
				project.data.summary && (
					<p class="project-lede" {...project.edit.summary}>
						{project.data.summary}
					</p>
				)
			}
			{technologies.length > 0 && <p class="stackline">{technologies.map((tech) => tech.label).join(" · ")}</p>}
			{
				(liveUrl || githubUrl) && (
					<div class="project-links">
						{liveUrl && (
							<a href={liveUrl} class="btn primary" target="_blank" rel="noopener noreferrer">
								Visit live site ↗
							</a>
						)}
						{githubUrl && (
							<a href={githubUrl} class="btn" target="_blank" rel="noopener noreferrer">
								View source ↗
							</a>
						)}
					</div>
				)
			}
		</header>

		{
			Demo && (
				<div class="project-demo">
					<Demo />
					{extras?.specs && extras.specs.length > 0 && (
						<dl class="spec">
							{extras.specs.map(([label, value]) => (
								<div>
									<dt>{label}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>
					)}
				</div>
			)
		}

		{
			project.data.featured_image && (
				<figure class="inst ticks project-cover" {...project.edit.featured_image}>
					<Image image={project.data.featured_image} />
				</figure>
			)
		}

		{
			project.data.content && project.data.content.length > 0 && (
				<div class="prose" {...project.edit.content}>
					<PortableText value={project.data.content} />
				</div>
			)
		}
	</article>
</Base>

<style>
	.project {
		max-width: calc(980px + var(--gutter) * 2);
	}

	.project-head {
		margin-bottom: clamp(32px, 5vw, 56px);
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 18px;
	}

	.project-meta .accent {
		color: var(--kapton);
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.project-meta .accent::before {
		content: "";
		width: 7px;
		height: 7px;
		border: 1px solid currentColor;
	}

	.project-title {
		margin-top: 22px;
		font-family: var(--f-display);
		font-stretch: 125%;
		--wdth: 125;
		font-weight: 720;
		font-size: clamp(40px, 6.4vw, 80px);
		line-height: 0.95;
		letter-spacing: -0.012em;
	}

	.project-lede {
		margin-top: 20px;
		font-family: var(--f-serif);
		font-style: italic;
		font-weight: 360;
		font-size: clamp(20px, 2.1vw, 25px);
		line-height: 1.35;
		color: var(--ink);
		max-width: 44ch;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 30px;
	}

	.project-demo {
		margin-bottom: clamp(32px, 5vw, 56px);
	}

	.project-cover {
		margin-bottom: clamp(32px, 5vw, 56px);
		padding: 10px;
	}

	.project-cover :global(img) {
		width: 100%;
		height: auto;
	}
</style>
