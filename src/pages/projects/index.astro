---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import SectionHead from "../../components/SectionHead.astro";
import { site } from "../../data/site";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const result = await getEmDashCollection("projects", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (result.error) {
	return new Response("Could not load projects", { status: 500 });
}
const { entries: projects, nextCursor, cacheHint } = result;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const techByProject = await getTermsForEntries(
	"projects",
	projects.map((p) => p.data.id),
	"tech",
);
---

<Base title="Projects" description="Things I've designed, built and shipped.">
	<div class="wrap page">
		<SectionHead level={1} eyebrow={site.projects.eyebrow} title="Projects" lede="Things I've designed, built and shipped." />

		{
			projects.length > 0 ? (
				<ul class="log">
					{projects.map((project, i) => (
						<ProjectRow
							title={project.data.title}
							href={`/projects/${project.id}`}
							summary={project.data.summary}
							year={project.data.year}
							technologies={(techByProject.get(project.data.id) ?? []).map((t) => t.label)}
							liveUrl={project.data.live_url}
							githubUrl={project.data.github_url}
							edit={project.edit}
							revealDelay={Math.min(i, 6) * 60}
						/>
					))}
				</ul>
			) : (
				<p class="empty-state">
					No projects yet. <a href="/_emdash/admin/content/projects/new">Add a project</a>.
				</p>
			)
		}

		{
			(cursor || nextCursor) && (
				<nav class="pagination" aria-label="Pagination">
					{cursor && (
						<a href="/projects" class="btn">
							← Newest
						</a>
					)}
					{nextCursor && (
						<a href={`/projects?cursor=${encodeURIComponent(nextCursor)}`} class="btn" rel="next">
							More projects →
						</a>
					)}
				</nav>
			)
		}
	</div>
</Base>
