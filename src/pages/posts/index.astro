---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import { site } from "../../data/site";
import { getReadingTime } from "../../lib/format";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const result = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});
if (result.error) {
	return new Response("Could not load posts", { status: 500 });
}
const { entries: posts, nextCursor, cacheHint } = result;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByPost = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
---

<Base title="Posts" description={site.writing.lede}>
	<div class="wrap page">
		<SectionHead level={1} eyebrow={site.writing.eyebrow} title={site.writing.title} lede={site.writing.lede} />

		{
			posts.length > 0 ? (
				<div class="log">
					{posts.map((post, i) => (
						<BlogCard
							title={post.data.title}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt}
							excerpt={post.data.excerpt}
							readingTime={getReadingTime(post.data.content)}
							tags={(tagsByPost.get(post.data.id) ?? []).map((t) => t.label)}
							edit={post.edit}
							revealDelay={Math.min(i, 6) * 60}
							level={2}
						/>
					))}
				</div>
			) : (
				<p class="empty-state">
					No posts yet. <a href="/_emdash/admin/content/posts/new">Write the first one</a>.
				</p>
			)
		}

		{
			(cursor || nextCursor) && (
				<nav class="pagination" aria-label="Pagination">
					{cursor && (
						<a href="/posts" class="btn">
							← Newest
						</a>
					)}
					{nextCursor && (
						<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`} class="btn" rel="next">
							Older posts →
						</a>
					)}
				</nav>
			)
		}
	</div>
</Base>
