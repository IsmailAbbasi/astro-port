---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getReadingTime } from "../../lib/format";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const result = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 12,
	cursor,
});
if (result.error) {
	return new Response("Could not load posts", { status: 500 });
}
const { entries: posts, nextCursor, cacheHint } = result;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Posts" description="Notes and articles on building for the web.">
	<div class="container">
		<header class="page-header" data-reveal>
			<h1 class="page-title">Posts</h1>
			<p class="page-intro">Notes and articles on building for the web.</p>
		</header>

		{
			posts.length > 0 ? (
				<div class="posts-list">
					{posts.map((post, i) => (
						<BlogCard
							title={post.data.title}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt}
							excerpt={post.data.excerpt}
							readingTime={getReadingTime(post.data.content)}
							edit={post.edit}
							revealDelay={Math.min(i, 6) * 60}
						/>
					))}
				</div>
			) : (
				<p class="empty-state">
					No posts yet. <a href="/_emdash/admin/content/posts/new">Write the first one</a>.
				</p>
			)
		}

		{
			(cursor || nextCursor) && (
				<nav class="pagination" aria-label="Pagination">
					{cursor && (
						<a href="/posts" class="btn btn-ghost">
							← Newest
						</a>
					)}
					{nextCursor && (
						<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`} class="btn btn-ghost" rel="next">
							Older posts →
						</a>
					)}
				</nav>
			)
		}
	</div>
</Base>

<style>
	.posts-list {
		display: grid;
		gap: var(--space-4);
	}

	.pagination {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}
</style>
