---
import { decodeSlug, getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import { formatDate, getReadingTime } from "../../lib/format";
import type { Post } from "../../../emdash-env";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: post, error, cacheHint } = await getEmDashEntry("posts", slug);
if (error) return new Response("Could not load the post", { status: 500 });
if (!post) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Absolute URL of the cover image for social previews.
function absoluteImageUrl(image: Post["featured_image"]): string | undefined {
	if (!image) return undefined;
	if (image.src) return image.src.startsWith("http") ? image.src : new URL(image.src, Astro.url.origin).href;
	const storageKey = typeof image.meta?.storageKey === "string" ? image.meta.storageKey : image.id;
	return storageKey ? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}` : undefined;
}

const seo = getSeoMeta(post, {
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
	defaultDescription: post.data.excerpt,
	defaultOgImage: absoluteImageUrl(post.data.featured_image),
});

const tags = post.data.terms?.tag ?? [];
const readingTime = getReadingTime(post.data.content);
const publishDate = formatDate(post.data.publishedAt, "long");
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="progress" aria-hidden="true" data-progress><div class="progress-bar"></div></div>

	<article class="wrap page article">
		<a href="/posts" class="back">← All posts</a>

		<header class="article-head">
			<p class="k article-meta">
				<span class="accent">{site.writing.eyebrow}</span>
				{publishDate && <time datetime={post.data.publishedAt?.toISOString()}>{publishDate}</time>}
				<span>{readingTime} min read</span>
			</p>
			<h1 class="article-title" {...post.edit.title}>{post.data.title}</h1>
			{
				post.data.excerpt && (
					<p class="article-lede" {...post.edit.excerpt}>
						{post.data.excerpt}
					</p>
				)
			}
			{
				tags.length > 0 && (
					<ul class="article-tags" aria-label="Tags">
						{tags.map((tag) => (
							<li class="chip">#{tag.label}</li>
						))}
					</ul>
				)
			}
		</header>

		{
			post.data.featured_image && (
				<figure class="inst ticks article-cover" {...post.edit.featured_image}>
					<Image image={post.data.featured_image} />
				</figure>
			)
		}

		<div class="prose article-body" {...post.edit.content}>
			<PortableText value={post.data.content} />
		</div>

		<footer class="article-foot">
			<a href="/posts" class="btn">← All posts</a>
			<a href="/#contact" class="lnk">Get in touch ↗</a>
		</footer>
	</article>

	<script>
		import { mount } from "../../scripts/lifecycle";

		// Reading progress bar
		mount("[data-progress]", (progress) => {
			const bar = progress.querySelector<HTMLElement>(".progress-bar");
			const article = document.querySelector<HTMLElement>(".article-body");
			if (!bar || !article) return;
			let ticking = false;
			const update = () => {
				const start = article.offsetTop;
				const end = start + article.offsetHeight - window.innerHeight;
				const value = end > start ? (window.scrollY - start) / (end - start) : 1;
				bar.style.transform = `scaleX(${Math.min(1, Math.max(0, value))})`;
				ticking = false;
			};
			const onScroll = () => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			};
			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll, { passive: true });
			update();
			return () => {
				window.removeEventListener("scroll", onScroll);
				window.removeEventListener("resize", onScroll);
			};
		});
	</script>
</Base>

<style>
	.progress {
		position: fixed;
		inset: 0 0 auto;
		height: 2px;
		z-index: 60;
		pointer-events: none;
	}

	.progress-bar {
		height: 100%;
		background: var(--fill);
		transform: scaleX(0);
		transform-origin: 0 50%;
	}

	.article {
		max-width: calc(880px + var(--gutter) * 2);
	}

	.article-head {
		margin-bottom: clamp(32px, 5vw, 56px);
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 18px;
	}

	.article-meta .accent {
		color: var(--kapton);
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.article-meta .accent::before {
		content: "";
		width: 7px;
		height: 7px;
		border: 1px solid currentColor;
	}

	.article-title {
		margin-top: 22px;
		font-family: var(--f-display);
		font-stretch: 118%;
		--wdth: 118;
		font-weight: 680;
		font-size: clamp(36px, 5.4vw, 64px);
		line-height: 1;
		letter-spacing: -0.012em;
	}

	.article-lede {
		margin-top: 20px;
		font-family: var(--f-serif);
		font-style: italic;
		font-weight: 360;
		font-size: clamp(20px, 2.1vw, 25px);
		line-height: 1.35;
		color: var(--ink-2);
		max-width: 48ch;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 24px;
		list-style: none;
	}

	.article-cover {
		margin-bottom: clamp(32px, 5vw, 56px);
		padding: 10px;
	}

	.article-cover :global(img) {
		width: 100%;
		height: auto;
	}

	.article-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: clamp(48px, 7vw, 80px);
		padding-top: 28px;
		border-top: 1px solid var(--rule);
	}
</style>
