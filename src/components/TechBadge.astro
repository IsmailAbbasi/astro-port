---
import { Image } from "emdash/ui";
import type { Stack } from "../../emdash-env";

interface Props {
	name: string;
	simpleIcon?: string;
	icon?: Stack["icon"];
}

const { name, simpleIcon, icon } = Astro.props;

// A custom uploaded icon wins; otherwise use the Simple Icons CDN
// (https://simpleicons.org) in a neutral colour that suits the dark theme.
const slug = simpleIcon?.trim().toLowerCase();
const simpleIconSrc = slug && /^[a-z0-9]+$/.test(slug) ? `https://cdn.simpleicons.org/${slug}/d4d4d8` : undefined;
---

<span class="tech-badge">
	{
		icon ? (
			<span class="badge-icon" aria-hidden="true">
				<Image image={icon} />
			</span>
		) : simpleIconSrc ? (
			<img class="badge-icon" src={simpleIconSrc} alt="" width="16" height="16" loading="lazy" decoding="async" onerror="this.remove()" />
		) : (
			<span class="badge-dot" aria-hidden="true" />
		)
	}
	{name}
</span>

<style>
	.tech-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.85rem;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--text-primary);
		background: var(--bg-primary);
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		transition:
			border-color var(--duration-fast),
			transform var(--duration) var(--ease-out),
			box-shadow var(--duration) var(--ease-out);
	}

	.tech-badge:hover {
		transform: translateY(-2px);
		border-color: hsla(35, 95%, 55%, 0.5);
		box-shadow: 0 6px 20px -10px hsla(35, 95%, 55%, 0.5);
	}

	.badge-icon,
	.badge-icon :global(img) {
		display: block;
		width: 16px;
		height: 16px;
		object-fit: contain;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--accent);
	}
</style>
