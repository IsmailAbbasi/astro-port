---
import { PortableText } from "emdash/ui";
import { site } from "../data/site";
import { DEFAULT_CV_PATH, fileUrl, flag, getProfile, getSocialLinks } from "../lib/profile";
import Globe from "./Globe.astro";

interface Props {
	profile: Awaited<ReturnType<typeof getProfile>>["profile"];
}

const { profile } = Astro.props;
const data = profile?.data;

const name = data?.title?.trim() || "Portfolio";
// "Mohd Ismail Abbasi" → small "Mohd" above two big lines, as in the design.
const words = name.split(/\s+/);
const nameLines = words.length > 1 ? words.slice(-2) : words;
const namePre = words.slice(0, -2).join(" ");

const available = flag(data?.available);
const cvUrl = fileUrl(data?.cv) ?? DEFAULT_CV_PATH;
const socials = getSocialLinks(data);
---

<section class="wrap hero" id="top">
	<div class="hero-copy">
		<p class="k hero-eyebrow">
			{data?.role && <span class="accent" {...profile?.edit.role}>{data.role}</span>}
			<span>{site.city} · {site.utcLabel}</span>
			{
				available && (
					<span class="open">
						<span class="led on" />
						Open to work
					</span>
				)
			}
		</p>

		<h1 class="name" aria-label={name}>
			{namePre && <span class="pre" aria-hidden="true">{namePre}</span>}
			{
				nameLines.map((line) => (
					<span class="l" aria-hidden="true">
						{line}
					</span>
				))
			}
		</h1>

		{
			data?.bio && data.bio.length > 0 && (
				<div class="thesis" {...profile?.edit.bio}>
					<PortableText value={data.bio} />
				</div>
			)
		}

		{
			site.now && (
				<p class="now">
					<span class="k">
						<span class="led on" />
						Now
					</span>
					<span>{site.now}</span>
				</p>
			)
		}

		<div class="cta">
			<a class="btn primary" href="#projects">See the work ↓</a>
			<a class="btn" href={cvUrl} download>Download CV ↓</a>
			{
				data?.email && (
					<button class="btn" type="button" data-copy-email={data.email}>
						Copy email
					</button>
				)
			}
			{
				socials.map((link) => (
					<a class="lnk" href={link.href} target="_blank" rel="me noopener noreferrer">
						{link.label} ↗
					</a>
				))
			}
		</div>
	</div>

	<Globe />
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
		gap: clamp(28px, 4vw, 64px);
		align-items: center;
		padding-block: clamp(44px, 7vw, 96px) clamp(36px, 5vw, 64px);
	}

	.hero-eyebrow {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 18px;
	}

	.hero-eyebrow > span {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.hero-eyebrow .accent {
		color: var(--kapton);
	}

	.hero-eyebrow .accent::before {
		content: "";
		width: 7px;
		height: 7px;
		border: 1px solid currentColor;
	}

	.hero-eyebrow .open {
		color: var(--nominal);
	}

	.name {
		font-family: var(--f-display);
		font-stretch: 125%;
		--wdth: 125;
		font-weight: 760;
		text-transform: uppercase;
		line-height: 0.86;
		letter-spacing: -0.005em;
		margin-top: 26px;
		font-size: clamp(50px, 15.2vw, 96px);
		overflow-wrap: anywhere;
	}

	.name .l {
		display: block;
	}

	.name .pre {
		display: block;
		font-family: var(--f-mono);
		font-stretch: 100%;
		--wdth: 100;
		font-size: 12px;
		letter-spacing: 0.42em;
		color: var(--kapton);
		font-weight: 500;
		line-height: 1;
		margin-bottom: 16px;
	}

	@media (min-width: 961px) {
		.name {
			font-size: clamp(72px, 7.9vw, 110px);
		}
	}

	/* The Profile bio. Bold words in the admin become the amber highlights. */
	.thesis {
		font-family: var(--f-serif);
		font-style: italic;
		font-weight: 340;
		font-size: clamp(22px, 2.35vw, 30px);
		line-height: 1.28;
		color: var(--ink);
		max-width: 27ch;
		margin-top: 30px;
		text-wrap: pretty;
	}

	.thesis :global(p + p) {
		margin-top: 0.6em;
	}

	.thesis :global(strong) {
		font-weight: inherit;
		color: var(--kapton-2);
	}

	.thesis :global(a) {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--kapton-line);
		text-underline-offset: 4px;
	}

	.now {
		display: flex;
		gap: 12px;
		align-items: baseline;
		margin-top: 22px;
		color: var(--ink-2);
		font-size: 15.5px;
		max-width: 48ch;
	}

	.now .k {
		color: var(--nominal);
		display: inline-flex;
		align-items: center;
		gap: 8px;
		flex: none;
	}

	.now .led {
		transform: translateY(-1px);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 22px;
		margin-top: 34px;
	}

	@media (max-width: 960px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}
</style>
