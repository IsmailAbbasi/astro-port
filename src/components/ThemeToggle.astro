---
/**
 * Light/dark switch in the top bar. The label says what a click will do and
 * is filled in by the script, since only the browser knows the theme.
 */
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme" title="Switch colour theme">
	<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
		<circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
		<path d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor"></path>
	</svg>
</button>

<script>
	import { mount } from "../scripts/lifecycle";
	import { applyTheme, currentTheme } from "../scripts/theme";

	mount<HTMLButtonElement>("[data-theme-toggle]", (button) => {
		const sync = () => {
			const next = currentTheme() === "light" ? "dark" : "light";
			const label = `Switch to ${next} theme`;
			button.setAttribute("aria-label", label);
			button.title = label;
		};
		const onClick = () => applyTheme(currentTheme() === "light" ? "dark" : "light", true);

		sync();
		button.addEventListener("click", onClick);
		document.addEventListener("themechange", sync);
		return () => document.removeEventListener("themechange", sync);
	});
</script>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		flex: none;
		color: var(--ink-2);
		background: transparent;
		border: 1px solid var(--rule-2);
		border-radius: 2px;
		cursor: pointer;
		transition:
			color 0.2s,
			border-color 0.2s;
	}

	.theme-toggle:hover {
		color: var(--kapton);
		border-color: var(--kapton);
	}

	.theme-toggle svg {
		transition: transform 0.4s var(--ease-out);
	}

	/* The filled half swings to the other side in light mode. */
	:global([data-theme="light"]) .theme-toggle svg {
		transform: rotate(180deg);
	}
</style>
