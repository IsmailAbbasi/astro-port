---
import type { EditProxy } from "emdash";
import { formatDate } from "../lib/format";

/** A post in a list, laid out like a work log entry. The whole row is clickable. */
interface Props {
	title: string;
	href: string;
	date?: Date | null;
	excerpt?: string;
	readingTime?: number;
	tags?: string[];
	edit?: EditProxy;
	revealDelay?: number;
	/** 3 inside a home page section, 2 on the posts page. */
	level?: 2 | 3;
}

const { title, href, date, excerpt, readingTime, tags = [], edit, revealDelay = 0, level = 3 } = Astro.props;
const formattedDate = formatDate(date);
const Heading = level === 2 ? "h2" : "h3";
---

<article class="entry post" data-reveal style={`--reveal-delay: ${revealDelay}ms`}>
	<div class="e-time">
		{formattedDate && <time class="e-date" datetime={date?.toISOString()}>{formattedDate}</time>}
		{readingTime && <span class="chip">{readingTime} min read</span>}
	</div>
	<div class="e-main">
		<Heading>
			<a href={href} class="post-link" {...edit?.title}>{title}</a>
		</Heading>
		{
			excerpt && (
				<p class="e-role" {...edit?.excerpt}>
					{excerpt}
				</p>
			)
		}
		{tags.length > 0 && <p class="stackline">{tags.map((tag) => `#${tag}`).join(" · ")}</p>}
	</div>
</article>

<style>
	.post {
		position: relative;
	}

	.post-link {
		transition: color 0.2s;
	}

	/* Stretch the title link over the whole entry. */
	.post-link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.post:hover .post-link {
		color: var(--kapton-2);
	}

	.post-link:focus-visible {
		outline: none;
	}

	.post-link:focus-visible::after {
		outline: 2px solid var(--kapton);
		outline-offset: -2px;
	}
</style>
