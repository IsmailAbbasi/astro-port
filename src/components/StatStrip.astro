---
import { site } from "../data/site";
---

{
	site.stats.length > 0 && (
		<div class="wrap">
			<div class="tele" aria-label="At a glance" role="group">
				{site.stats.map((stat) => (
					<div class="t-cell">
						<span class="k">{stat.label}</span>
						<span class="t-v">{stat.value}</span>
						<span class="t-s">{stat.note}</span>
					</div>
				))}
			</div>
		</div>
	)
}

<style>
	.tele {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		background: var(--rule);
		border: 1px solid var(--rule);
	}

	.t-cell {
		background: var(--void);
		padding: 22px 22px 24px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.t-v {
		font-family: var(--f-display);
		font-stretch: 118%;
		--wdth: 118;
		font-weight: 620;
		font-size: clamp(19px, 1.8vw, 23px);
		line-height: 1.15;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.t-s {
		font-size: 13.5px;
		color: var(--dim);
		line-height: 1.45;
	}

	@media (max-width: 860px) {
		.tele {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 400px) {
		.t-cell {
			padding: 18px 14px 20px;
		}
	}
</style>
