---
/** Intercept API sample: a request log that fills in live. */
---

<div class="inst ticks" data-demo-intercept>
	<div class="inst-head"><span class="k">Request log · localhost:3000</span><span class="inst-tag">Sample</span></div>
	<div class="inst-body">
		<div class="req-head">
			<span class="ts">Time</span><span>Method</span><span>Path</span><span>Code</span><span class="note">Note</span>
		</div>
		<div data-reqs></div>
	</div>
	<div class="inst-foot"><span class="led on"></span><span>Tunnel connected · webhooks relayed to localhost</span></div>
</div>

<script>
	import { clockString, mount, reduceMotion } from "../../scripts/lifecycle";

	type Req = [method: string, path: string, status: number, ms: number, tag: string];

	const REQ: Req[] = [
		["POST", "/webhooks/payments", 200, 41, "tunnel"],
		["GET", "/api/users/me", 200, 12, ""],
		["GET", "/api/invoices?page=2", 200, 27, ""],
		["PATCH", "/api/orders/918", 409, 19, ""],
		["GET", "/api/pricing", 200, 2, "mocked"],
		["POST", "/api/auth/refresh", 401, 8, ""],
		["POST", "/api/auth/refresh", 200, 15, "replayed"],
		["POST", "/webhooks/github", 201, 33, "tunnel"],
		["GET", "/api/health", 200, 3, ""],
		["DELETE", "/api/sessions/7", 204, 11, ""],
	];
	const IST = 330;

	function row(r: Req, fresh: boolean, stamp: string): HTMLElement {
		const el = document.createElement("div");
		el.className = `req${fresh ? " new" : ""}`;
		const meta = r[4] ? `<span class="tagm">${r[4]}</span>` : `${r[3]} ms`;
		el.innerHTML = `<span class="ts">${stamp}</span><span class="m m-${r[0]}">${r[0]}</span><span class="path">${r[1]}</span><span class="st-${String(r[2])[0]}">${r[2]}</span><span class="meta">${meta}</span>`;
		return el;
	}

	mount("[data-demo-intercept]", (root) => {
		const box = root.querySelector<HTMLElement>("[data-reqs]");
		if (!box) return;
		let idx = 0;
		const now = Date.now();
		for (let i = 5; i >= 0; i--) {
			box.insertBefore(row(REQ[idx % REQ.length], false, clockString(IST, now - i * 2100)), box.firstChild);
			idx++;
		}
		if (reduceMotion) return;
		const timer = window.setInterval(() => {
			if (document.hidden) return;
			box.insertBefore(row(REQ[idx % REQ.length], true, clockString(IST)), box.firstChild);
			idx++;
			while (box.children.length > 6) box.lastElementChild?.remove();
		}, 2100);
		return () => clearInterval(timer);
	});
</script>

<style is:global>
	/* Global: the rows are created by the script, so scoped styles wouldn't reach them. */
	.req-head,
	.req {
		display: grid;
		grid-template-columns: 62px 54px minmax(0, 1fr) 34px 70px;
		gap: 10px;
		align-items: center;
	}

	.req-head {
		padding-bottom: 8px;
		border-bottom: 1px solid var(--rule);
	}

	.req-head span {
		font-family: var(--f-mono);
		font-size: 9px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--dim);
	}

	.req-head .note {
		justify-self: end;
	}

	.req {
		padding: 10px 0;
		border-bottom: 1px dashed var(--rule);
		font-family: var(--f-mono);
		font-stretch: 87.5%;
		--wdth: 87.5;
		font-size: 11.5px;
		font-variant-numeric: tabular-nums;
	}

	.req .ts {
		color: var(--dim);
	}

	.req .path {
		color: var(--ink);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.req .m {
		font-weight: 600;
	}

	.m-GET {
		color: var(--ink-2);
	}

	.m-POST {
		color: var(--kapton-2);
	}

	.m-PATCH {
		color: var(--patch);
	}

	.m-DELETE {
		color: var(--fault);
	}

	.st-2 {
		color: var(--nominal);
	}

	.st-4 {
		color: var(--fault);
	}

	.req .meta {
		justify-self: end;
		color: var(--dim);
	}

	.tagm {
		font-size: 9px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 2px 6px;
		border: 1px solid var(--kapton-line);
		color: var(--kapton);
		border-radius: 2px;
	}

	.req.new {
		animation: req-flash 1.6s ease-out;
	}

	@keyframes req-flash {
		from {
			background: var(--kapton-bg);
		}
		to {
			background: transparent;
		}
	}

	@media (max-width: 560px) {
		.req-head,
		.req {
			grid-template-columns: 50px minmax(0, 1fr) 32px 64px;
		}

		.req .ts,
		.req-head .ts {
			display: none;
		}
	}
</style>
