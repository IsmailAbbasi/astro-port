---
/** ExaminateAI sample: a quiz builder that "writes" a question from a source. */
---

<div class="inst ticks" data-demo-examinate>
	<div class="inst-head"><span class="k">Quiz builder</span><span class="inst-tag">Sample run</span></div>
	<div class="inst-body">
		<div class="qz">
			<div class="qz-row"><span class="k">Source</span><span class="v" data-qz="src">cell-biology-notes.pdf <span>· 12 pages</span></span></div>
			<div class="qz-row"><span class="k">Level</span><span class="v" data-qz="lvl">Medium</span></div>
			<div class="qz-prog">
				<span class="k" data-qz="stage">Written</span>
				<div class="track"><div class="fill" data-qz="fill"></div></div>
				<span data-qz="count">10/10</span>
			</div>
			<div class="qz-card">
				<p class="qz-n" data-qz="n">Question 4 of 10</p>
				<p class="qz-text" data-qz="text">Which organelle produces most of a cell's ATP?</p>
				<ol class="qz-opts" data-qz="opts"></ol>
			</div>
		</div>
	</div>
</div>

<script>
	import { mount, reduceMotion } from "../../scripts/lifecycle";

	interface Sample {
		src: string;
		meta: string;
		lvl: string;
		n: number;
		q: string;
		o: string[];
		a: number;
	}

	const QZ: Sample[] = [
		{
			src: "cell-biology-notes.pdf",
			meta: "12 pages",
			lvl: "Medium",
			n: 4,
			q: "Which organelle produces most of a cell's ATP?",
			o: ["Ribosome", "Mitochondrion", "Golgi apparatus", "Lysosome"],
			a: 1,
		},
		{
			src: "Topic: Indian Constitution",
			meta: "typed topic",
			lvl: "Easy",
			n: 2,
			q: "Which article of the Indian Constitution abolishes untouchability?",
			o: ["Article 14", "Article 17", "Article 21", "Article 32"],
			a: 1,
		},
		{
			src: "dbms-unit-3.txt",
			meta: "4,180 words",
			lvl: "Hard",
			n: 7,
			q: "Which normal form removes transitive dependencies between non-key attributes?",
			o: ["1NF", "2NF", "3NF", "4NF"],
			a: 2,
		},
	];

	mount("[data-demo-examinate]", (root) => {
		const $ = (name: string) => root.querySelector<HTMLElement>(`[data-qz="${name}"]`)!;
		const src = $("src");
		const lvl = $("lvl");
		const stage = $("stage");
		const fill = $("fill");
		const count = $("count");
		const n = $("n");
		const text = $("text");
		const opts = $("opts");

		function show(s: Sample, done: boolean) {
			src.textContent = `${s.src} `;
			const meta = document.createElement("span");
			meta.textContent = `· ${s.meta}`;
			src.append(meta);
			lvl.textContent = s.lvl;
			if (!done) return;
			stage.textContent = "Written";
			count.textContent = "10/10";
			fill.style.width = "100%";
			n.textContent = `Question ${s.n} of 10 · ${s.lvl}`;
			text.textContent = s.q;
			opts.innerHTML = s.o
				.map(
					(o, i) =>
						`<li class="${i === s.a ? "ok" : ""}"><b>${"ABCD"[i]}</b><span>${o}</span>${i === s.a ? '<span class="mark">Answer</span>' : ""}</li>`,
				)
				.join("");
		}

		show(QZ[0], true);
		if (reduceMotion) return;

		let qi = 0;
		let step = 0;
		let writing = 0;
		const timer = window.setInterval(() => {
			if (document.hidden) return;
			qi = (qi + 1) % QZ.length;
			const s = QZ[qi];
			show(s, false);
			stage.textContent = "Reading";
			text.textContent = "…";
			n.textContent = "Generating";
			opts.innerHTML = "";
			fill.style.width = "0%";
			count.textContent = "0/10";
			step = 0;
			clearInterval(writing);
			writing = window.setInterval(() => {
				step++;
				if (step <= 10) {
					fill.style.width = `${step * 10}%`;
					count.textContent = `${step}/10`;
					if (step === 4) stage.textContent = "Writing";
				} else {
					clearInterval(writing);
					show(s, true);
				}
			}, 170);
		}, 6500);

		return () => {
			clearInterval(timer);
			clearInterval(writing);
		};
	});
</script>

<style is:global>
	/* Global: the options list is created by the script. */
	.qz {
		display: grid;
		gap: 16px;
	}

	.qz-row {
		display: grid;
		grid-template-columns: 78px minmax(0, 1fr);
		gap: 12px;
		align-items: baseline;
		font-family: var(--f-mono);
		font-stretch: 87.5%;
		--wdth: 87.5;
		font-size: 11.5px;
	}

	.qz-row .v {
		color: var(--ink);
		overflow-wrap: anywhere;
	}

	.qz-row .v span {
		color: var(--dim);
	}

	.qz-prog {
		display: grid;
		grid-template-columns: 78px minmax(0, 1fr) 44px;
		gap: 12px;
		align-items: center;
		font-family: var(--f-mono);
		font-stretch: 87.5%;
		--wdth: 87.5;
		font-size: 11.5px;
		font-variant-numeric: tabular-nums;
	}

	.track {
		height: 4px;
		background: var(--rule);
		position: relative;
		overflow: hidden;
	}

	.track .fill {
		position: absolute;
		inset: 0 auto 0 0;
		background: var(--kapton);
		width: 100%;
	}

	.qz-card {
		border-top: 1px solid var(--rule);
		padding-top: 16px;
	}

	.qz-n {
		font-family: var(--f-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--kapton);
	}

	.qz-text {
		margin: 8px 0 14px;
		font-size: 17px;
		line-height: 1.4;
		color: var(--ink);
		font-weight: 500;
	}

	.qz-opts {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
	}

	.qz-opts li {
		display: flex;
		gap: 10px;
		align-items: center;
		border: 1px solid var(--rule);
		padding: 9px 12px;
		font-size: 14px;
		color: var(--ink-2);
		border-radius: 2px;
		transition:
			border-color 0.3s,
			color 0.3s;
	}

	.qz-opts li b {
		font-family: var(--f-mono);
		font-size: 10px;
		font-weight: 500;
		color: var(--dim);
	}

	.qz-opts li.ok {
		border-color: var(--nominal-line);
		color: var(--ink);
	}

	.qz-opts li.ok b {
		color: var(--nominal);
	}

	.qz-opts li .mark {
		margin-left: auto;
		font-family: var(--f-mono);
		font-size: 9px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--nominal);
	}

	@media (max-width: 560px) {
		.qz-opts {
			grid-template-columns: 1fr;
		}
	}
</style>
