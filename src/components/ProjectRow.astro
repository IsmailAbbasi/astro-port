---
import type { EditProxy } from "emdash";
import { safeExternalUrl } from "../lib/profile";

/** A project on the /projects page, laid out like a work log entry. */
interface Props {
	title: string;
	href: string;
	summary?: string;
	year?: string;
	technologies?: string[];
	liveUrl?: string;
	githubUrl?: string;
	edit?: EditProxy;
	revealDelay?: number;
}

const { title, href, summary, year, technologies = [], liveUrl, githubUrl, edit, revealDelay = 0 } = Astro.props;
const live = safeExternalUrl(liveUrl);
const github = safeExternalUrl(githubUrl);
const liveLabel = live ? new URL(live).host.replace(/^www\./, "") : undefined;
---

<li class="entry project" data-reveal style={`--reveal-delay: ${revealDelay}ms`}>
	<div class="e-time">
		{year && <span class="e-date">{year}</span>}
		{
			live && (
				<span class="chip live">
					<span class="led on" />
					Live
				</span>
			)
		}
	</div>
	<div class="e-main">
		<h2>
			{/* The ::after of this link covers the whole row (stretched link) */}
			<a href={href} class="project-link" {...edit?.title}>{title}</a>
		</h2>
		{
			summary && (
				<p class="e-role" {...edit?.summary}>
					{summary}
				</p>
			)
		}
		{technologies.length > 0 && <p class="stackline">{technologies.join(" · ")}</p>}
		{
			(live || github) && (
				<p class="project-out">
					{live && (
						<a href={live} target="_blank" rel="noopener noreferrer">
							{liveLabel} ↗
						</a>
					)}
					{github && (
						<a href={github} target="_blank" rel="noopener noreferrer">
							Source ↗
						</a>
					)}
				</p>
			)
		}
	</div>
</li>

<style>
	.project {
		position: relative;
	}

	.project-link {
		transition: color 0.2s;
	}

	.project-link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.project:hover .project-link {
		color: var(--kapton-2);
	}

	.project-link:focus-visible {
		outline: none;
	}

	.project-link:focus-visible::after {
		outline: 2px solid var(--kapton);
		outline-offset: -2px;
	}

	.project-out {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 22px;
		margin-top: 18px;
	}

	/* Above the stretched link, so these open the external sites. */
	.project-out a {
		position: relative;
		z-index: 1;
		font-family: var(--f-mono);
		font-size: 11.5px;
		letter-spacing: 0.06em;
		color: var(--kapton);
		border-bottom: 1px solid var(--kapton-line);
		padding-bottom: 3px;
	}

	.project-out a:hover {
		color: var(--kapton-2);
		border-color: var(--kapton-2);
	}
</style>
