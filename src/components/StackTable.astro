---
import { site } from "../data/site";
import SectionHead from "./SectionHead.astro";

interface Row {
	layer: string;
	use: string;
	tools: string[];
}

interface Props {
	/** Tech Stack entries from the CMS, grouped by category, in display order. */
	groups: [category: string, tools: string[]][];
}

const { groups } = Astro.props;

const rows: Row[] = [
	...groups.map(([category, tools]) => ({
		layer: site.stack.layers[category]?.layer ?? category,
		use: site.stack.layers[category]?.use ?? "",
		tools,
	})),
	...site.stack.extraRows,
];
---

{
	rows.length > 0 && (
		<section class="wrap sec" id="stack" aria-labelledby="stack-title">
			<SectionHead id="stack-title" eyebrow={site.stack.eyebrow} title={site.stack.title} lede={site.stack.lede} />
			<table class="tbl" data-reveal>
				<thead>
					<tr>
						<th scope="col">Layer</th>
						<th scope="col">Used for</th>
						<th scope="col">Tools</th>
					</tr>
				</thead>
				<tbody>
					{rows.map((row) => (
						<tr>
							<th scope="row">{row.layer}</th>
							<td class="use">{row.use}</td>
							<td class="tools">
								{row.tools.map((tool) => (
									<span>{tool}</span>
								))}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</section>
	)
}

<style>
	.tbl {
		width: 100%;
		border-collapse: collapse;
	}

	.tbl thead th {
		font-family: var(--f-mono);
		font-size: 9.5px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--dim);
		font-weight: 400;
		text-align: left;
		padding: 0 20px 12px 0;
		border-bottom: 1px solid var(--rule-2);
	}

	.tbl tbody th,
	.tbl td {
		text-align: left;
		vertical-align: top;
		padding: 22px 20px 22px 0;
		border-bottom: 1px solid var(--rule);
	}

	.tbl tbody th {
		font-family: var(--f-display);
		font-stretch: 118%;
		--wdth: 118;
		font-weight: 640;
		font-size: 19px;
		color: var(--ink);
		width: 22%;
		line-height: 1.3;
	}

	.tbl td.use {
		color: var(--ink-2);
		width: 38%;
	}

	.tbl td.tools {
		font-family: var(--f-mono);
		font-size: 12px;
		line-height: 1.9;
		color: var(--ink);
	}

	.tbl td.tools span {
		white-space: nowrap;
	}

	.tbl td.tools span:not(:last-child)::after {
		content: " · ";
		color: var(--rule-2);
		white-space: pre;
	}

	.tbl tbody tr {
		transition: background 0.25s;
	}

	.tbl tbody tr:hover {
		background: linear-gradient(90deg, var(--kapton-bg), transparent 60%);
	}

	@media (max-width: 720px) {
		.tbl thead {
			display: none;
		}

		.tbl,
		.tbl tbody,
		.tbl tr,
		.tbl th,
		.tbl td {
			display: block;
			width: auto;
		}

		.tbl tbody tr {
			padding: 20px 0;
			border-bottom: 1px solid var(--rule);
		}

		.tbl tbody th,
		.tbl td {
			border: 0;
			padding: 0;
		}

		.tbl tbody th,
		.tbl td.use {
			width: auto;
		}

		.tbl td.use {
			margin-top: 4px;
		}

		.tbl td.tools {
			margin-top: 10px;
		}
	}
</style>
